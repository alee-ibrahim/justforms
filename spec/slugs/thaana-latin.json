  "texts": [
    {
      "thaana": "ބައްޕަ މާދަމާ ރަށަށް އަންނާނެއެވެ.",
      "latin": "Bappa maadhamaa rashaiy annaaneeve."
    },
    {
      "thaana": "ޢަމަލު، ކަނޑި؟ ޤައުމީ ދުވަސް",
      "latin": "A'malu, kan'di? Qaumee dhuvas"
    },
    {
      "thaana": "މަސައްކަތުގެ ފުރުޞަތު ހޯދުމަށް އެދޭ ފޯމު",
      "latin": "Masakkathuge furus'athu hoadhumaiy edhey foamu"
    },
    {
      "thaana": "ޒުވާނުންގެ ޕްރޮގްރާމް 2026 ގައި ބައިވެރިވުމަށް",
      "latin": "Zuvaanunge prograam 2026 gai baiverivumaiy"
    },
    {
      "thaana": "އެނބޫދޫ ރަށުގެ އަނބު. ކަނޑު ރީތި!",
      "latin": "En'boodhoo rashuge an'bu. Kan'du reethi!"
    },
    {
      "thaana": "ޢީދު މުބާރަކް",
      "latin": "E'edhu mubaarak"
    },
    {
      "thaana": "މީހެއް ގަސް ފޮށް",
      "latin": "Meeheh gas foiy"
    }
  ]
}
