{
  "name": "design_example",
  "description": "The DESIGN section 4.4 youth programme form",
  "schema": {
    "schemaVersion": "1",
    "settings": {
      "language": "dv",
      "title": "ޒުވާނުންގެ ޕްރޮގްރާމަށް ހުށަހަޅާ ފޯމު",
      "submitLabel": "ހުށަހަޅާ",
      "successMessage": "ޝުކުރިއްޔާ!",
      "theme": {
        "accent": "#0f766e",
        "logoFileId": null
      }
    },
    "pages": [
      {
        "id": "p_applicant",
        "title": "އަމިއްލަ މައުލޫމާތު",
        "elements": [
          {
            "kind": "field",
            "id": "full_name",
            "type": "short_text",
            "label": "ފުރިހަމަ ނަން",
            "required": true,
            "inputScript": "auto",
            "maxLength": 120
          },
          {
            "kind": "field",
            "id": "national_id",
            "type": "short_text",
            "label": "އައިޑީ ކާޑު ނަންބަރު",
            "required": true,
            "pattern": "^A[0-9]{6}$",
            "patternMessage": "ފޯމެޓް: A123456",
            "inputScript": "latin",
            "sensitive": true
          },
          {
            "kind": "field",
            "id": "age",
            "type": "number",
            "label": "އުމުރު",
            "required": true,
            "integer": true,
            "min": 15,
            "max": 35
          },
          {
            "kind": "field",
            "id": "has_dependents",
            "type": "yes_no",
            "label": "ބަލަހައްޓަންޖެހޭ މީހުން ތިބިތޯ؟",
            "required": true
          },
          {
            "kind": "repeater",
            "id": "dependents",
            "label": "ބަލަހައްޓަންޖެހޭ މީހުން",
            "minRows": 1,
            "maxRows": 10,
            "addLabel": "އިތުރުކުރޭ",
            "visibleIf": {
              "field": "has_dependents",
              "op": "eq",
              "value": true
            },
            "elements": [
              {
                "kind": "field",
                "id": "dep_name",
                "type": "short_text",
                "label": "ނަން",
                "required": true
              },
              {
                "kind": "field",
                "id": "dep_relation",
                "type": "single_choice",
                "label": "ގުޅުން",
                "required": true,
                "display": "dropdown",
                "options": [
                  {
                    "value": "child",
                    "label": "ދަރިފުޅު"
                  },
                  {
                    "value": "parent",
                    "label": "މައިންބަފައިން"
                  },
                  {
                    "value": "other",
                    "label": "އެހެނިހެން"
                  }
                ]
              },
              {
                "kind": "field",
                "id": "dep_relation_other",
                "type": "short_text",
                "label": "ބަޔާންކުރައްވާ",
                "visibleIf": {
                  "field": "dep_relation",
                  "op": "eq",
                  "value": "other"
                },
                "required": true
              }
            ]
          }
        ],
        "next": [
          {
            "if": {
              "field": "age",
              "op": "lt",
              "value": 18
            },
            "goto": "p_guardian"
          }
        ]
      },
      {
        "id": "p_guardian",
        "title": "ބެލެނިވެރިޔާ",
        "visibleIf": {
          "field": "age",
          "op": "lt",
          "value": 18
        },
        "elements": [
          {
            "kind": "field",
            "id": "guardian_name",
            "type": "short_text",
            "label": "ބެލެނިވެރިޔާގެ ނަން",
            "required": true
          },
          {
            "kind": "field",
            "id": "guardian_phone",
            "type": "phone",
            "label": "ފޯނު ނަންބަރު",
            "defaultCountry": "MV",
            "required": true
          }
        ]
      },
      {
        "id": "p_docs",
        "title": "ލިޔެކިޔުން",
        "elements": [
          {
            "kind": "section",
            "id": "sec_docs",
            "title": "ލިޔެކިޔުން",
            "elements": [
              {
                "kind": "field",
                "id": "id_copy",
                "type": "file",
                "label": "އައިޑީ ކާޑުގެ ކޮޕީ",
                "required": true,
                "accept": [
                  "application/pdf",
                  "image/jpeg",
                  "image/png"
                ],
                "maxFiles": 2,
                "maxSizeMb": 10
              },
              {
                "kind": "field",
                "id": "interests",
                "type": "multi_choice",
                "label": "ޝައުގުވެރިވާ ދާއިރާތައް",
                "minSelected": 1,
                "maxSelected": 3,
                "options": [
                  {
                    "value": "law",
                    "label": "ގާނޫނު"
                  },
                  {
                    "value": "media",
                    "label": "މީޑިއާ"
                  },
                  {
                    "value": "it",
                    "label": "އައިޓީ"
                  }
                ]
              }
            ]
          },
          {
            "kind": "content",
            "id": "decl_text",
            "contentType": "paragraph",
            "text": "މަތީގައިވާ މައުލޫމާތަކީ ތެދު މައުލޫމާތުކަން ކަށަވަރުކުރަމެވެ."
          },
          {
            "kind": "field",
            "id": "applicant_signature",
            "type": "signature",
            "label": "ސޮއި",
            "required": true,
            "attestation": "އަޅުގަނޑު މި ފޯމުގައި ސޮއިކުރަމެވެ."
          },
          {
            "kind": "field",
            "id": "guardian_signature",
            "type": "signature",
            "label": "ބެލެނިވެރިޔާގެ ސޮއި",
            "requiredIf": {
              "field": "age",
              "op": "lt",
              "value": 18
            },
            "visibleIf": {
              "field": "age",
              "op": "lt",
              "value": 18
            }
          }
        ]
      }
    ]
  },
  "cases": [
    {
      "name": "under-18 routes to guardian page and requires guardian signature",
      "answers": {
        "age": 17,
        "has_dependents": false
      },
      "expect": {
        "visible": [
          "full_name",
          "age",
          "has_dependents",
          "guardian_name",
          "guardian_signature"
        ],
        "hidden": [
          "dependents"
        ],
        "required": [
          "guardian_signature"
        ],
        "path": [
          "p_applicant",
          "p_guardian",
          "p_docs"
        ],
        "strippedAnswers": {
          "age": 17,
          "has_dependents": false
        }
      }
    },
    {
      "name": "adult skips the guardian page",
      "answers": {
        "age": 20,
        "guardian_name": "x"
      },
      "expect": {
        "hidden": [
          "guardian_name",
          "guardian_phone",
          "guardian_signature",
          "dependents"
        ],
        "notRequired": [
          "guardian_signature"
        ],
        "path": [
          "p_applicant",
          "p_docs"
        ],
        "strippedAnswers": {
          "age": 20
        }
      }
    },
    {
      "name": "dependent with relation other",
      "answers": {
        "age": 17,
        "has_dependents": true,
        "dependents": [
          {
            "dep_name": "A",
            "dep_relation": "other",
            "dep_relation_other": "x"
          }
        ]
      },
      "expect": {
        "visible": [
          "dependents"
        ],
        "rows": {
          "dependents": [
            {
              "visible": [
                "dep_name",
                "dep_relation",
                "dep_relation_other"
              ],
              "required": [
                "dep_relation_other"
              ]
            }
          ]
        }
      }
    },
    {
      "name": "age missing does not route to guardian",
      "answers": {},
      "expect": {
        "path": [
          "p_applicant",
          "p_docs"
        ],
        "hidden": [
          "guardian_signature"
        ]
      }
    },
    {
      "name": "age as string does not route",
      "answers": {
        "age": "17"
      },
      "expect": {
        "path": [
          "p_applicant",
          "p_docs"
        ]
      }
    },
    {
      "name": "age 18 is not under 18",
      "answers": {
        "age": 18
      },
      "expect": {
        "path": [
          "p_applicant",
          "p_docs"
        ]
      }
    },
    {
      "name": "dependent child hides the specify field",
      "answers": {
        "age": 30,
        "has_dependents": true,
        "dependents": [
          {
            "dep_name": "A",
            "dep_relation": "child",
            "dep_relation_other": "x"
          }
        ],
        "interests": [
          "law"
        ]
      },
      "expect": {
        "rows": {
          "dependents": [
            {
              "hidden": [
                "dep_relation_other"
              ]
            }
          ]
        },
        "strippedAnswers": {
          "age": 30,
          "has_dependents": true,
          "dependents": [
            {
              "dep_name": "A",
              "dep_relation": "child"
            }
          ],
          "interests": [
            "law"
          ]
        }
      }
    }
  ]
}
