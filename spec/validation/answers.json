      "value": "2025-12-31",
      "expect": {
        "code": "date_from",
        "params": {
          "date": "2026-01-01"
        }
      }
    },
    {
      "name": "date after maxDate",
      "field": {
        "type": "date",
        "maxDate": "2026-12-31"
      },
      "value": "2027-01-01",
      "expect": {
        "code": "date_to",
        "params": {
          "date": "2026-12-31"
        }
      }
    },
    {
      "name": "date relative today ok",
      "field": {
        "type": "date",
        "minDate": "today"
      },
      "value": "2026-10-23",
      "expect": null
    },
    {
      "name": "date relative today before",
      "field": {
        "type": "date",
        "minDate": "today"
      },
      "value": "2026-10-22",
      "expect": {
        "code": "date_from",
        "params": {
          "date": "2026-10-23"
        }
      }
    },
    {
      "name": "date relative today+30 after",
      "field": {
        "type": "date",
        "maxDate": "today+30"
      },
      "value": "2026-11-23",
      "expect": {
        "code": "date_to",
        "params": {
          "date": "2026-11-22"
        }
      }
    },
    {
      "name": "date relative today-1",
      "field": {
        "type": "date",
        "maxDate": "today-1"
