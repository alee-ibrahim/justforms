    {
      "name": "email surrounding spaces are ignored",
      "field": {
        "type": "email"
      },
      "value": " name@example.org ",
      "expect": null
    },
    {
      "name": "email without domain dot",
      "field": {
        "type": "email"
      },
      "value": "name@example",
      "expect": {
        "code": "email"
      }
    },
    {
      "name": "email with space",
      "field": {
        "type": "email"
      },
      "value": "na me@example.org",
      "expect": {
        "code": "email"
      }
    },
    {
      "name": "email not a string",
      "field": {
        "type": "email"
      },
      "value": 5,
      "expect": {
        "code": "email"
      }
    },
    {
      "name": "mv phone ok",
      "field": {
        "type": "phone"
      },
      "value": "+9607771234",
      "expect": null
    },
    {
      "name": "mv phone short",
      "field": {
        "type": "phone"
      },
      "value": "+960777123",
      "expect": {
        "code": "phone_mv"
      }
    },
    {
      "name": "mv phone long",
      "field": {
        "type": "phone"
      },
      "value": "+96077712345",
      "expect": {
        "code": "phone_mv"
      }
    },
    {
      "name": "other country ok",
      "field": {
        "type": "phone"
      },
      "value": "+447700900123",
      "expect": null
    },
    {
      "name": "phone without plus",
      "field": {
        "type": "phone"
      },
      "value": "7771234",
      "expect": {
        "code": "phone"
      }
    },
    {
      "name": "phone with letters",
      "field": {
        "type": "phone"
      },
      "value": "+44abc",
      "expect": {
        "code": "phone"
      }
    },
    {
      "name": "number ok",
      "field": {
        "type": "number"
      },
      "value": 3.5,
      "expect": null
