    {
      "name": "number as a string",
      "field": {
        "type": "number"
      },
      "value": "5",
      "expect": {
        "code": "number"
      }
    },
    {
      "name": "boolean is not a number",
      "field": {
        "type": "number"
      },
      "value": true,
      "expect": {
        "code": "number"
      }
    },
    {
      "name": "integer required",
      "field": {
        "type": "number",
        "integer": true
      },
      "value": 1.5,
      "expect": {
        "code": "integer"
      }
    },
    {
      "name": "integer ok",
      "field": {
        "type": "number",
        "integer": true
      },
      "value": 2,
      "expect": null
    },
    {
      "name": "between",
      "field": {
        "type": "number",
        "min": 15,
        "max": 35
      },
      "value": 40,
      "expect": {
        "code": "between",
        "params": {
          "min": 15,
          "max": 35
        }
      }
    },
    {
      "name": "at range edge",
      "field": {
        "type": "number",
        "min": 15,
        "max": 35
      },
      "value": 35,
      "expect": null
    },
    {
      "name": "at least",
      "field": {
        "type": "number",
        "min": 1
      },
      "value": 0,
      "expect": {
        "code": "at_least",
        "params": {
          "min": 1
        }
      }
    },
    {
      "name": "at most",
      "field": {
        "type": "number",
        "max": 10
      },
      "value": 10.5,
      "expect": {
        "code": "at_most",
        "params": {
          "max": 10
        }
      }
    },
    {
      "name": "number beyond 2^53",
      "field": {
        "type": "number"
      },
      "value": 1152921504606846976,
      "expect": {
        "code": "number"
      }
    },
    {
      "name": "fractional limits",
      "field": {
        "type": "number",
