{
  "description": "Per-answer validation shared by the renderer (frontend/src/renderer/validation.ts) and the server (backend/app/validation/answers.py). Each case checks one answer of one visible field (kind, id and label are filled in); `required` defaults to false; a missing `value` means unanswered. `today` resolves relative date limits. `expect` is null or {code, params?}.",
  "today": "2026-10-23",
  "cases": [
    {
      "name": "missing optional is fine",
      "field": {
        "type": "short_text"
      },
      "expect": null
    },
    {
      "name": "missing required",
      "field": {
        "type": "short_text"
      },
      "required": true,
      "expect": {
        "code": "required"
      }
    },
    {
      "name": "empty string counts as missing",
      "field": {
        "type": "short_text"
      },
      "value": "",
      "required": true,
      "expect": {
        "code": "required"
      }
    },
    {
      "name": "empty list counts as missing",
      "field": {
        "type": "multi_choice",
        "options": [
          {
            "value": "a",
            "label": "A"
          },
          {
            "value": "b",
            "label": "B"
          }
        ],
        "minSelected": 2
      },
      "value": [],
      "required": true,
      "expect": {
        "code": "required",
        "params": {
          "n": 2
        }
      }
    },
    {
      "name": "required multi choice without minimum asks for one",
      "field": {
        "type": "multi_choice",
        "options": [
          {
            "value": "a",
            "label": "A"
          }
        ]
      },
      "value": null,
      "required": true,
      "expect": {
        "code": "required",
        "params": {
          "n": 1
        }
      }
    },
    {
      "name": "required yes/no false is an answer",
      "field": {
        "type": "yes_no"
      },
      "value": false,
      "required": true,
      "expect": null
    },
    {
      "name": "required number zero is an answer",
      "field": {
        "type": "number"
      },
      "value": 0,
      "required": true,
      "expect": null
    },
    {
      "name": "short text ok",
      "field": {
        "type": "short_text"
      },
      "value": "Aminath",
      "expect": null
    },
    {
      "name": "short text not a string",
      "field": {
        "type": "short_text"
      },
      "value": 12,
      "expect": {
        "code": "invalid"
      }
    },
    {
      "name": "short text over maxLength",
      "field": {
        "type": "short_text",
        "maxLength": 3
      },
      "value": "abcd",
      "expect": {
        "code": "too_long",
        "params": {
          "max": 3
        }
      }
    },
    {
      "name": "short text at maxLength",
      "field": {
        "type": "short_text",
        "maxLength": 3
      },
      "value": "abc",
      "expect": null
    },
    {
      "name": "short text over the default cap",
      "field": {
        "type": "short_text"
      },
      "value": "",
      "expect": {
        "code": "too_long",
        "params": {
          "max": 10000
        }
      }
    },
    {
      "name": "pattern matches",
      "field": {
        "type": "short_text",
        "pattern": "^A[0-9]{6}$"
      },
      "value": "A123456",
      "expect": null
    },
    {
      "name": "pattern fails",
      "field": {
        "type": "short_text",
        "pattern": "^A[0-9]{6}$"
      },
      "value": "B12",
      "expect": {
        "code": "pattern"
      }
    },
    {
      "name": "pattern is a search, not a full match",
      "field": {
        "type": "short_text",
        "pattern": "[0-9]"
      },
      "value": "abc1",
      "expect": null
    },
    {
      "name": "broken pattern is ignored",
      "field": {
        "type": "short_text",
        "pattern": "(unclosed"
      },
      "value": "anything",
      "expect": null
    },
    {
      "name": "thaana text passes",
      "field": {
        "type": "short_text"
      },
      "value": "އާއިޝަތު",
      "expect": null
    },
    {
      "name": "long text ok",
      "field": {
        "type": "long_text"
      },
      "value": "line 1\nline 2",
      "expect": null
    },
    {
      "name": "long text over maxLength",
      "field": {
        "type": "long_text",
        "maxLength": 5
      },
      "value": "123456",
      "expect": {
        "code": "too_long",
        "params": {
          "max": 5
        }
      }
    },
    {
      "name": "email ok",
      "field": {
        "type": "email"
      },
      "value": "name@example.org",
      "expect": null
