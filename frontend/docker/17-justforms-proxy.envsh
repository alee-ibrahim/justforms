#!/bin/sh
# Client address and HSTS for nginx.conf (DESIGN 14.1). Sourced by the nginx image's entrypoint
# before the templates are rendered.
#   JUSTFORMS_REAL_IP_FROM    proxies in front of this container (load balancer, ingress,
#                             tunnel, CDN): addresses or CIDRs, comma- or space-separated. Only
#                             requests from these peers may name another client address. Empty
#                             (default): the peer is the client.
#   JUSTFORMS_REAL_IP_HEADER  where those proxies put the client address: X-Forwarded-For
#                             (default; the right-most address that is not one of them is used)
#                             or a one-address header set by a CDN, e.g. CF-Connecting-IP.
#   JUSTFORMS_HSTS            auto (default: only for requests that came over HTTPS, as told by
#                             X-Forwarded-Proto), off, or the Strict-Transport-Security value to
#                             send on every response, e.g. "max-age=31536000; includeSubDomains".
# The API always gets the result as a single X-Forwarded-For hop ($remote_addr), never a list
# the client could have written into.

real_ip_conf=/etc/nginx/conf.d/00-justforms-real-ip.conf
real_ip_from=$(printf '%s' "${JUSTFORMS_REAL_IP_FROM:-}" | tr ',' ' ')
real_ip_header="${JUSTFORMS_REAL_IP_HEADER:-X-Forwarded-For}"

if ! printf '%s' "$real_ip_header" | grep -Eq '^[A-Za-z0-9-]+$'; then
  echo "JUSTFORMS_REAL_IP_HEADER must be a header name, got: $real_ip_header" >&2
  exit 1
fi

{
  echo "# Generated by 17-justforms-proxy.envsh from JUSTFORMS_REAL_IP_FROM/_HEADER."
  if [ -n "$(printf '%s' "$real_ip_from" | tr -d ' ')" ]; then
    for entry in $real_ip_from; do
      if ! printf '%s' "$entry" | grep -Eq '^[0-9A-Fa-f:.]+(/[0-9]{1,3})?$'; then
        echo "JUSTFORMS_REAL_IP_FROM: not an address or CIDR: $entry" >&2
        exit 1
      fi
      echo "set_real_ip_from $entry;"
    done
    echo "real_ip_header $real_ip_header;"
    echo "real_ip_recursive on;"
  fi
} > "$real_ip_conf" || exit 1

hsts="${JUSTFORMS_HSTS:-auto}"
case "$hsts" in
  *'"'* | *'$'* | *'\'* | *'
'*)
    echo "JUSTFORMS_HSTS must not contain quotes, \$ or backslashes" >&2
    exit 1
    ;;
esac
case "$hsts" in
  auto)
    export JUSTFORMS_HSTS_HTTPS="max-age=31536000; includeSubDomains"
    export JUSTFORMS_HSTS_OTHER=""
    ;;
  off | false | none)
    export JUSTFORMS_HSTS_HTTPS=""
    export JUSTFORMS_HSTS_OTHER=""
    ;;
  *)
    export JUSTFORMS_HSTS_HTTPS="$hsts"
    export JUSTFORMS_HSTS_OTHER="$hsts"
    ;;
esac
