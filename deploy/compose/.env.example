# Copy to .env and change every value marked change-me. Never commit .env.

JUSTFORMS_ENVIRONMENT=development
JUSTFORMS_HTTP_PORT=8080
# Must match the URL you open in the browser (used for redirects and Origin checks).
JUSTFORMS_PUBLIC_URL=http://localhost:8080
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JUSTFORMS_SECRET_KEY=change-me-long-random-string
# Set to true when serving over HTTPS.
JUSTFORMS_COOKIE_SECURE=false

POSTGRES_USER=justforms
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=justforms

# -- Staff login --------------------------------------------------------------------
# Without an OIDC issuer, staff sign in with emailed one-time codes. Create the first admin:
#   docker compose run --rm migrate python -m app.cli create-admin --email you@example.org
# JUSTFORMS_OIDC_ISSUER=https://idp.example.org/realms/example
# JUSTFORMS_OIDC_CLIENT_ID=justforms
# JUSTFORMS_OIDC_CLIENT_SECRET=change-me
# JUSTFORMS_OIDC_ADMIN_GROUPS=justforms-admins
# JUSTFORMS_OIDC_CREATOR_GROUPS=justforms-builders
# JUSTFORMS_OIDC_MEMBER_GROUPS=justforms-users
# IdP groups whose people are superadmins (exact names or group IDs; independent of the above).
# JUSTFORMS_OIDC_SUPERADMIN_GROUPS=justforms-superadmins
# Without group mapping, people's role the first time they sign in: creator (default), member,
# or none (they join only when invited).
# JUSTFORMS_OIDC_DEFAULT_ROLE=creator
#
# DEMO INSTANCES ONLY - never on a real install. A fixed 6-digit sign-in code that works
# (after "Email me a sign-in code") for the listed addresses only, so a demo can be shown
# without reading the email. The list is required; obvious codes (000000, 123456, ...) are
# refused at start-up, the backend logs a warning and the sign-in page says "Demo instance".
# JUSTFORMS_DEMO_LOGIN_CODE=<random 6 digits>
# JUSTFORMS_DEMO_LOGIN_EMAILS=demo@example.org

# -- Email ----------------------------------------------------------------------------
# Real SMTP relay:
# JUSTFORMS_SMTP_HOST=smtp.example.org
# JUSTFORMS_SMTP_PORT=587
# JUSTFORMS_SMTP_USERNAME=change-me
# JUSTFORMS_SMTP_PASSWORD=change-me
# JUSTFORMS_SMTP_SECURITY=starttls
# JUSTFORMS_SMTP_FROM=JustForms <forms@example.org>
# Development: `--profile dev` starts mailpit (UI on http://localhost:8025).
JUSTFORMS_SMTP_HOST=mailpit
JUSTFORMS_SMTP_PORT=1025
JUSTFORMS_SMTP_SECURITY=none

# -- Dev Keycloak overlay (docker-compose.keycloak.yml) --------------------------------
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
KEYCLOAK_DEV_CLIENT_SECRET=change-me-client-secret
KEYCLOAK_DEV_USER_PASSWORD=change-me-dev-users

# -- Cloudflare Tunnel (optional) -----------------------------------------------------
# `--profile tunnel` (just tunnel): token of a named tunnel whose public hostname points at
# http://frontend:80. `--profile quick-tunnel` (just quick-tunnel) needs no token and prints a
# temporary https://<random>.trycloudflare.com URL. Either way set JUSTFORMS_PUBLIC_URL to the
# tunnel URL and JUSTFORMS_COOKIE_SECURE=true, then restart backend and worker.
# CLOUDFLARE_TUNNEL_TOKEN=change-me
# JUSTFORMS_PUBLIC_URL=https://forms.example.org
# JUSTFORMS_COOKIE_SECURE=true
# JUSTFORMS_TRUSTED_PROXIES=172.16.0.0/12

# -- File storage ---------------------------------------------------------------------
# "local" (default) keeps files on the storage-data volume.
# Set to "s3" to use an external S3-compatible service and fill in the JUSTFORMS_S3_* values.
JUSTFORMS_STORAGE_BACKEND=local
# JUSTFORMS_S3_ENDPOINT_URL=https://s3.example.org   # leave empty for AWS S3
# JUSTFORMS_S3_PUBLIC_ENDPOINT_URL=                  # browsers' endpoint, if not the one above
# JUSTFORMS_S3_REGION=us-east-1
# JUSTFORMS_S3_BUCKET=justforms
# JUSTFORMS_S3_ACCESS_KEY_ID=change-me
# JUSTFORMS_S3_SECRET_ACCESS_KEY=change-me
# JUSTFORMS_S3_ADDRESSING_STYLE=auto                 # path | virtual | auto

# Largest single upload in MB (nginx accepts up to 50).
# JUSTFORMS_MAX_UPLOAD_MB=25
# Optional Jotform API key: exact submit times for submission imports, and the
# fetch-imported-files / rebuild-jotform-import commands. Never stored or logged.
# JUSTFORMS_JOTFORM_API_KEY=
# Time zone for dates in exports and PDFs, and "today" in date limits.
# JUSTFORMS_TIMEZONE=UTC
# How long an approver's emailed link works, in days (sending it again makes a new one).
# JUSTFORMS_APPROVAL_LINK_DAYS=14
# How long an invitation to join an organisation stays open, in days (a resend restarts it).
# JUSTFORMS_INVITE_DAYS=14
# Reverse proxies whose X-Forwarded-For is trusted for recorded IP addresses (IPs or CIDRs).
# JUSTFORMS_TRUSTED_PROXIES=172.16.0.0/12

# -- Signed PDFs -----------------------------------------------------------------------
# By default the install signs PDFs with its own key, created on first start and stored
# encrypted with JUSTFORMS_SECRET_KEY (keep that secret stable). To use an organisation
# certificate, mount a PKCS#12 file into the api and worker containers and set:
# JUSTFORMS_PDF_SIGNING_P12=/run/secrets/pdf-signing.p12
# JUSTFORMS_PDF_SIGNING_P12_PASSWORD=change-me
# Optional RFC 3161 timestamp authority:
# JUSTFORMS_PDF_TSA_URL=https://tsa.example.org

# -- Abuse controls (DESIGN 14) ---------------------------------------------------------
# Rate limits are on by default. Override single limits as name=count/seconds, e.g.
# JUSTFORMS_RATE_LIMITS=public_submit=20/60,upload_init=60/60
# JUSTFORMS_RATE_LIMIT_ENABLED=true
# Optional CAPTCHA that forms can turn on: none (default), altcha (proof of work in the
# browser, no third party), turnstile or hcaptcha (need the site and secret keys).
# JUSTFORMS_CAPTCHA_PROVIDER=none
# JUSTFORMS_CAPTCHA_SITE_KEY=change-me
# JUSTFORMS_CAPTCHA_SECRET_KEY=change-me

# -- Webhooks ---------------------------------------------------------------------------
# Webhooks to private, loopback or link-local addresses are refused unless the address is
# inside one of these ranges (plain http is also only allowed to them).
# JUSTFORMS_WEBHOOK_ALLOWED_CIDRS=10.20.0.0/16

# -- Content Security Policy ------------------------------------------------------------
# Extra origins the browser may connect to, e.g. your S3 bucket with JUSTFORMS_STORAGE_BACKEND=s3
# (uploads go straight to it): https://justforms.s3.example.org
# JUSTFORMS_CSP_EXTRA_CONNECT_SRC=

# Directory with operator-supplied fonts (e.g. licensed Faruma), served at /fonts/.
# JUSTFORMS_FONTS_DIR=./fonts
# Stylesheet that provides Faruma. Default: the public dvfonts CDN (third party; it sees
# visitors' IP addresses). Self-host: put faruma.css + font files in the fonts directory and
# set /fonts/faruma.css. Empty: bundled Noto Sans Thaana only.
# JUSTFORMS_THAANA_FONT_CSS_URL=https://dvfonts.yashau.com/css2?family=Faruma&display=swap
# Thaana fonts form themes can choose (family names, the first is the default). With the font
# service above each loads from it; with a self-hosted stylesheet list only what it provides.
# JUSTFORMS_THAANA_FONTS=Faruma,MV Faseyha,MV A Waheed,MV Typewriter,Bolhu

# Host ports (bound to 127.0.0.1) for local development outside Docker.
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_PORT=8025

# AI assistant (optional; hidden unless a provider is set). Give JustForms its own key; never
# reuse another application's. gemini and anthropic need a key; openai_compat needs a base
# URL (OpenAI, Azure OpenAI, vLLM, Ollama, LM Studio...) and a key only if the server wants one.
# JUSTFORMS_AI_PROVIDER=none
# JUSTFORMS_AI_MODEL=
# JUSTFORMS_AI_API_KEY=
# JUSTFORMS_AI_BASE_URL=
# JUSTFORMS_AI_VISION_MODEL=
# JUSTFORMS_AI_VISION=
# JUSTFORMS_AI_PROVIDER_LABEL=

# -- Branding (instance defaults; each organisation can override them in the studio) ----------
# JUSTFORMS_BRAND_NAME=Example Forms
# JUSTFORMS_BRAND_PRIMARY_COLOR="#0F766E"
# JUSTFORMS_BRAND_SUPPORT_URL=https://example.org/help
# Files in ./branding (JUSTFORMS_BRANDING_DIR), seen by the API as /etc/justforms/branding/...
# JUSTFORMS_BRAND_LOGO_FILE=/etc/justforms/branding/logo.svg
# JUSTFORMS_BRAND_LOGO_DARK_FILE=
# JUSTFORMS_BRAND_ICON_FILE=/etc/justforms/branding/icon.png
# optional | always (organisations can't hide "Powered by JustForms")
# JUSTFORMS_BRAND_POWERED_BY=optional
