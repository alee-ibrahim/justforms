# Backend settings for running outside Docker (uv run ...). Copy to backend/.env.
# All settings use the JUSTFORMS_ prefix; see app/config.py.
# Passwords/ports must match deploy/compose/.env when using `just infra`.
JUSTFORMS_ENVIRONMENT=development
JUSTFORMS_DATABASE_URL=postgresql+asyncpg://justforms:change-me-postgres@127.0.0.1:5432/justforms
JUSTFORMS_REDIS_URL=redis://127.0.0.1:6379/0

# File storage: "local" (default, files under JUSTFORMS_STORAGE_LOCAL_PATH) or "s3".
JUSTFORMS_STORAGE_BACKEND=local
JUSTFORMS_STORAGE_LOCAL_PATH=data/storage

# Only for JUSTFORMS_STORAGE_BACKEND=s3 (any S3-compatible service; endpoint empty for AWS).
# JUSTFORMS_S3_ENDPOINT_URL=https://s3.example.org
# Endpoint in presigned URLs for browsers, only if they reach the service at another address:
# JUSTFORMS_S3_PUBLIC_ENDPOINT_URL=https://files.example.org
# JUSTFORMS_S3_REGION=us-east-1
# JUSTFORMS_S3_BUCKET=justforms
# JUSTFORMS_S3_ACCESS_KEY_ID=change-me
# JUSTFORMS_S3_SECRET_ACCESS_KEY=change-me
# JUSTFORMS_S3_ADDRESSING_STYLE=auto

# Public URL of the SPA (redirects, Origin checks) and the key for HMACs/tokens.
JUSTFORMS_PUBLIC_URL=http://localhost:5173
JUSTFORMS_SECRET_KEY=change-me-long-random-string

# Staff login. Without JUSTFORMS_OIDC_ISSUER, staff sign in with emailed one-time codes;
# create the first admin with: uv run python -m app.cli create-admin --email you@example.org
# JUSTFORMS_OIDC_ISSUER=https://idp.example.org/realms/example
# JUSTFORMS_OIDC_CLIENT_ID=justforms
# JUSTFORMS_OIDC_CLIENT_SECRET=change-me
# JUSTFORMS_OIDC_ADMIN_GROUPS=justforms-admins
# JUSTFORMS_OIDC_CREATOR_GROUPS=justforms-builders
# JUSTFORMS_OIDC_MEMBER_GROUPS=justforms-users
# IdP groups whose people are superadmins (exact names or group IDs; independent of the above).
# JUSTFORMS_OIDC_SUPERADMIN_GROUPS=justforms-superadmins
# Without group mapping, people's role the first time they sign in: creator (default), member,
# or none (they join only when invited).
# JUSTFORMS_OIDC_DEFAULT_ROLE=creator

# SMTP for sign-in codes and notifications (dev: mailpit on 1025, no auth).
JUSTFORMS_SMTP_HOST=127.0.0.1
JUSTFORMS_SMTP_PORT=1025
JUSTFORMS_SMTP_SECURITY=none
JUSTFORMS_SMTP_FROM=JustForms <no-reply@example.org>

# Stylesheet providing the Faruma Thaana font (default: the public dvfonts CDN). Point it at a
# self-hosted copy such as /fonts/faruma.css, or leave it empty to use only the bundled fallback.
# JUSTFORMS_THAANA_FONT_CSS_URL=https://dvfonts.yashau.com/css2?family=Faruma&display=swap

# Abuse controls: rate limits (on by default; override as name=count/seconds) and an
# optional CAPTCHA forms can turn on (none, altcha, turnstile, hcaptcha).
# JUSTFORMS_RATE_LIMIT_ENABLED=true
# JUSTFORMS_RATE_LIMITS=public_submit=20/60
# JUSTFORMS_CAPTCHA_PROVIDER=altcha
# JUSTFORMS_CAPTCHA_SITE_KEY=change-me
# JUSTFORMS_CAPTCHA_SECRET_KEY=change-me

# Webhooks to private addresses (e.g. a receiver on this machine) need an allowlist.
# JUSTFORMS_WEBHOOK_ALLOWED_CIDRS=127.0.0.0/8

# AI assistant (optional; hidden unless a provider is set). Give JustForms its own key; never
# reuse another application's. gemini and anthropic need a key; openai_compat needs a base
# URL (OpenAI, Azure OpenAI, vLLM, Ollama, LM Studio...) and a key only if the server wants one.
# JUSTFORMS_AI_PROVIDER=none
# JUSTFORMS_AI_MODEL=
# JUSTFORMS_AI_API_KEY=
# JUSTFORMS_AI_BASE_URL=
# JUSTFORMS_AI_VISION_MODEL=
# JUSTFORMS_AI_VISION=
# JUSTFORMS_AI_PROVIDER_LABEL=
